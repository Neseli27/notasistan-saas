rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Geçici geliştirme kuralı:
    // Sadece Firebase Authentication ile giriş yapan kullanıcılar okuyabilir/yazabilir.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
